# The game and everything made from it never go in the repo.
# Need for Speed Underground 2 (SPEED2.EXE and its data, EA's copyrighted content):
/Need for Speed Underground 2*/
# Need for Speed Undercover. The owned install stays outside this tree
# (C:\Games\Need For Speed Undercover is read only and is not a path in the repo).
/Need for Speed Undercover*/
/Need For Speed Undercover*/
/nfs.exe
/NFSU_*.exe
# Most Wanted copy used by the upstream port (its folder and zip):
/mw/
# C translated from a game executable (NFSU2 gen/, and the Undercover experiment):
/gen/
/generated/
# Compiled modules, apps and distribution archives:
/out/
/build/
/dist/

# Original or generated game material. Reports under analysis/ are text and JSON
# statistics; they are not executables and are not matched by these suffixes.
*.exe
*.dll
*.wasm
*.bin
*.iso
*.img
*.pak
*.pdb
*.dmp
*.sys

# Tools and build output
/.venv
/deps
node_modules
/web/dist/
/web/dist-dev/
__pycache__/
*.pyc
*.o
*.log
.DS_Store

# Machine-local Node path discovered by Phase 48 tooling (WinGet/portable).
/tools/.node-path.txt

# Accidental progress.py --help output directory (Phase 48 note; leave alone).
/--help/

# Private LAN development TLS material (must stay outside the repo; belt-and-suspenders).
*.pem
**/lan-certs/
.ca.crt
/server.key
/ca.key

# Ephemeral esbuild test bundles
/web/test/uc-*-bundle-*.mjs
